{
  "name": "blessed-company",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "data": "tsx scripts/csv-to-ts.ts",
    "dev": "npm run data && vite",
    "dev:lan": "npm run data && vite --host",
    "build": "npm run data && tsc --noEmit && vite build",
    "test": "npm run data && vitest run",
    "test:fast": "npm run data && vitest run --exclude src/core/floorGenerator.test.ts --exclude src/core/autoRun.parity.test.ts",
    "lint": "eslint src scripts",
    "format": "prettier --write src scripts",
    "soak": "npm run data --silent && tsx scripts/soak.ts",
    "fight": "npm run data && tsx scripts/fight.ts",
    "assets": "tsx scripts/copy-assets.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
